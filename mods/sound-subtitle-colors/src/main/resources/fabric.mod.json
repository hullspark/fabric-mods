{
	"schemaVersion": 1,
	"id": "sound-subtitle-colors",
	"version": "${version}",
	"name": "Sound Subtitle Colors",
	"description": "Color-codes sound subtitles by category (hostile, friendly, block, weather, player, other) for easier at-a-glance reading. AI-assisted development.",
	"authors": [
		"Hullspark"
	],
	"contact": {
		"homepage": "https://github.com/hullspark/minecraft-mods"
	},
	"license": "MIT",
	"icon": "assets/soundsubtitlecolors/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.hullspark.subtitlecolors.client.SoundSubtitleColorsClient"
		]
	},
	"mixins": [
		"sound-subtitle-colors.client.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.0",
		"fabric-api": "*",
		"minecraft": "1.21.11"
	}
}
